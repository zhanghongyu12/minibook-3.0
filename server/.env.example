# MiniBook F-15 服务端配置示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，禁止入库）

# ── 数据库：双 DSN（DEC-031）────────────────────────────────────────────
# 开发 / 单测（默认，零依赖，直接可用）
DATABASE_URL=sqlite:///./dev.db
# 生产 / 联调（MySQL 8；拿到连接信息后换成下面这行）
# DATABASE_URL=mysql+pymysql://minibook:CHANGE_ME@127.0.0.1:3306/minibook?charset=utf8mb4

# ── 令牌（DEC-032）─────────────────────────────────────────────────────
# 生产必须换成随机值（≥32 字节）：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-insecure-change-me-please-rotate-32b
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── 拉取分页 ───────────────────────────────────────────────────────────
PULL_LIMIT_DEFAULT=200
PULL_LIMIT_MAX=500

# ── 登录/注册限流（次/分钟/IP+用户名）───────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=10
