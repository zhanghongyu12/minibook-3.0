# ── 本地开发配置模板（复制为 server/.env）────────────────────────────────
# 用法：cp server/.env.local.example server/.env
# （server/.env 已被 .gitignore 忽略，**严禁提交**；本模板里只有占位/开发默认值）
#
# 适用：本机跑 API、pytest、模拟器 adb reverse 联调（调试包默认指向 127.0.0.1:8000）
# 远程/线上部署用另一份：server/.env.remote.example

# ── 数据库：本地 SQLite（零依赖，直接可用）──────────────────────────────
DATABASE_URL=sqlite:///./dev.db

# ── 令牌：本地开发用默认值即可（生产必须换，见 .env.remote.example）─────
JWT_SECRET=dev-insecure-change-me-please-rotate-32b
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── 拉取分页 ───────────────────────────────────────────────────────────
PULL_LIMIT_DEFAULT=200
PULL_LIMIT_MAX=500

# ── 登录/注册限流（次/分钟/IP+用户名）───────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── 接口文档开关 ───────────────────────────────────────────────────────
# 本地开发开着方便（/docs、/openapi.json）；公网入口必须 false
ENABLE_DOCS=true
