# ── 远程（云服务器 / 线上）配置模板 ─────────────────────────────────────
# 用法：拷到服务器的 /opt/docker/minibook-api/.env 再填真实值（chmod 600）
# **本文件永远只有占位符**：真实口令与地址一律不进版本库
# （提交前体检：tools/check-secrets.ps1）
#
# 适用：云服务器上的 MySQL 8 容器 + minibook-api 容器；或本机经 SSH 隧道直连远程 MySQL 联调
# 本地开发用另一份：server/.env.local.example

# ── 数据库：远程 MySQL 8（容器名 mysql，容器内端口 49779）───────────────
# 真实口令只存在于服务器 .env 与本机密码管理器里
DATABASE_URL=mysql+pymysql://minibook:CHANGE_ME@mysql:49779/minibook?charset=utf8mb4
# 本机经隧道直连同一套远程库时的写法：
# DATABASE_URL=mysql+pymysql://minibook:CHANGE_ME@127.0.0.1:49779/minibook?charset=utf8mb4

# ── 令牌：线上必须换成随机值（≥32 字节）────────────────────────────────
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── 拉取分页 ───────────────────────────────────────────────────────────
PULL_LIMIT_DEFAULT=200
PULL_LIMIT_MAX=500

# ── 登录/注册限流（次/分钟/IP+用户名）───────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── 接口文档开关：公网明文入口必须关 ────────────────────────────────────
ENABLE_DOCS=false

# ── 不在仓库里保存的其它远程信息（自行管理，勿写入本文件后提交）─────────
# 公网 IP / 域名、对外服务端口、SSH 端口与密钥、数据库口令、联调测试账号
# 本机侧对应文件：sync.properties（App 入口地址，已 gitignore）
