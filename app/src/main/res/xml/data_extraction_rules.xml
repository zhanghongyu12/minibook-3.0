<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-006：备份分级策略——数据库已整体加密且密钥存于本机，备份/云恢复均不得带出 DB 与 key 文件。
     强制 allowBackup=false + 此规则双保险；换机迁移走「应用内导出 JSON → 新机导入」。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="no_backup" path="minibook_key.bin" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <full-backup-content>
        <exclude domain="database" path="." />
        <exclude domain="no_backup" path="minibook_key.bin" />
        <exclude domain="file" path="." />
    </full-backup-content>
</data-extraction-rules>