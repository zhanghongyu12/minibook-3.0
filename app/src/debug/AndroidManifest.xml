<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建合并本清单：允许明文 HTTP，用于「本机 / 局域网开发服务器」联调（docs/14_cloud_sync.md §6）。
  release 不合并本文件 ⇒ 沿用平台默认（targetSdk 28+ 禁止明文 HTTP），公网部署必须 HTTPS。
  因此「用正式包连 http://内网IP」会被系统拦截；客户端会把它识别为
  SyncErrorCode.CLEARTEXT_BLOCKED 并给出可读提示，而不是笼统的「网络错误」。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
